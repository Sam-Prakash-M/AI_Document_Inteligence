# Copy to .env and fill in. Never commit .env.

# ---- API access (min 16 chars). Generate one with:  openssl rand -hex 32
APP_API_KEY=change-me-to-a-long-random-string
APP_API_KEY_NAME=default
RATE_LIMIT_RPM=60

# ---- Option A: OpenAI for chat + embeddings (default)
OPENAI_API_KEY=
CHAT_PROVIDER=openai
CHAT_MODEL=gpt-4.1-mini
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ---- Option B: Anthropic Claude for chat (embeddings still need openai or ollama)
# CHAT_PROVIDER=anthropic
# CHAT_MODEL=claude-sonnet-5-5
# CHAT_API_KEY=sk-ant-...

# ---- Option C: fully local with Ollama (docker compose --profile ollama up -d)
#   then: docker compose exec ollama ollama pull llama3.2
#         docker compose exec ollama ollama pull nomic-embed-text
# CHAT_PROVIDER=ollama
# CHAT_MODEL=llama3.2
# CHAT_BASE_URL=http://ollama:11434
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_BASE_URL=http://ollama:11434
# EMBEDDING_DIMENSION=768

# ---- Misc
# DB_PASSWORD=docintel
# MAX_UPLOAD_SIZE=20MB
